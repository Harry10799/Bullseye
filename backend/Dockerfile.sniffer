# Bullseye Sniffer — production-grade multi-stage Dockerfile
#
# Build context: backend/  (parent of sniffer/, includes proto/)
#   docker build -t bullseye/sniffer:latest -f backend/Dockerfile.sniffer backend/
#
# The sniffer depends on the proto module (../proto) via a replace directive,
# so the build context must include both sniffer/ and proto/.
#
# Image features:
#   - Multi-stage build, final image ~30MB
#   - libpcap installed (real AF_PACKET capture)
#   - Built with `-tags libpcap` so capture code is included
#   - Non-root user (UID 65532) — but capabilities granted via DaemonSet
#   - Health check via built-in /healthz (planned v1.1) — for now, just check process
#   - Supports linux/amd64 + linux/arm64

# syntax=docker/dockerfile:1.7
ARG GOLANG_VERSION=1.23
ARG ALPINE_VERSION=3.20

# --- Stage 1: builder ---
FROM golang:${GOLANG_VERSION}-alpine AS builder

# libpcap-dev required to compile github.com/google/gopacket/pcap (CGO)
RUN apk add --no-cache git gcc musl-dev libpcap-dev

WORKDIR /src

# Cache module downloads
COPY sniffer/go.mod sniffer/go.sum ./sniffer/
COPY proto/go.mod ./proto/
COPY proto/bullseye/ ./proto/bullseye/

WORKDIR /src/sniffer
RUN go mod download

# Copy the rest of the source
WORKDIR /src
COPY sniffer/ ./sniffer/
COPY proto/ ./proto/

# Build args
ARG VERSION=dev
ARG BUILD_DATE
ARG COMMIT

WORKDIR /src/sniffer

# CGO_ENABLED=1 required for libpcap (gopacket/pcap)
# -tags libpcap enables the real AF_PACKET capture code (afpacket_libpcap.go)
# -ldflags="-s -w" strips debug info
# -trimpath for reproducible builds
# -extldflags=-static for fully static binary (no musl dep at runtime)
RUN CGO_ENABLED=1 GOOS=linux \
    go build \
      -tags libpcap \
      -trimpath \
      -ldflags="-s -w \
        -extldflags=-static \
        -X main.version=${VERSION} \
        -X main.buildDate=${BUILD_DATE} \
        -X main.commit=${COMMIT}" \
      -o /sniffer \
      ./cmd/sniffer/

# Also build fake-sniffer for testing
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /fake-sniffer ./cmd/fake-sniffer/

# Also build load-test
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /load-test ./cmd/load-test/

# Verify static linking (should print "not a dynamic executable")
RUN file /sniffer | grep -q "static" || (echo "ERROR: sniffer not statically linked" && file /sniffer && exit 1)

# --- Stage 2: runtime ---
FROM alpine:${ALPINE_VERSION} AS runtime

# Runtime deps:
#   - ca-certificates: TLS for hub gRPC connection
#   - tzdata: timezone-aware logging
#   - libpcap: required at runtime for AF_PACKET (even though binary is static)
#   - wget: healthcheck
RUN apk add --no-cache ca-certificates tzdata libpcap wget && \
    addgroup -g 65532 -S bullseye && \
    adduser -u 65532 -S -G bullseye -h /home/bullseye bullseye

# Copy binaries
COPY --from=builder /sniffer /usr/local/bin/sniffer
COPY --from=builder /fake-sniffer /usr/local/bin/fake-sniffer
COPY --from=builder /load-test /usr/local/bin/load-test

USER bullseye

# Port for Prometheus metrics (sniffer exposes its own /metrics on 49101)
EXPOSE 49101

# Health check — sniffer doesn't have an HTTP endpoint yet (v1.1), so just
# check the binary is alive by checking if the process responds to signals.
# For now we skip health check; rely on K8s liveness probe (TCP socket).
# HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
#     CMD wget -qO- http://127.0.0.1:49101/healthz || exit 1

ARG VERSION=dev
ARG BUILD_DATE
ARG COMMIT
LABEL org.opencontainers.image.title="Bullseye Sniffer" \
      org.opencontainers.image.description="Bullseye DaemonSet sniffer — captures L7 traffic via AF_PACKET, dissects, streams to hub" \
      org.opencontainers.image.source="https://github.com/bullseye/bullseye" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.authors="Bullseye Contributors"

ENTRYPOINT ["/usr/local/bin/sniffer"]
